{
  "name": "fire-lol",
  "productName": "FIRE LoL",
  "version": "1.10.1",
  "description": "FIRE LoL - les stats de l'équipe, à jour depuis dpm.lol",
  "main": "main.js",
  "author": "Toka120",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('renderer/vendor',{recursive:true});fs.copyFileSync('node_modules/d3/dist/d3.min.js','renderer/vendor/d3.min.js')\"",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "d3": "7.9.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "lol.fire.team",
    "productName": "FIRE LoL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "coach.js",
      "teamgrab.js",
      "jeux.js",
      "worlds.js",
      "lanes.json",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/fire.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FIRE LoL",
      "installerIcon": "assets/fire.ico",
      "uninstallerIcon": "assets/fire.ico",
      "artifactName": "FIRE-LoL-Setup.exe"
    },
    "portable": {
      "artifactName": "FIRE-LoL-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Toka120",
        "repo": "fire-team-lol",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
