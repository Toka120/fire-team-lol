{
  "name": "fire-lol",
  "productName": "FIRE LoL",
  "version": "1.10.34",
  "description": "FIRE LoL - les stats de l'équipe, à jour depuis dpm.lol",
  "main": "main.js",
  "author": "Toka120",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('renderer/vendor',{recursive:true});fs.copyFileSync('node_modules/d3/dist/d3.min.js','renderer/vendor/d3.min.js');fs.copyFileSync('node_modules/peerjs/dist/peerjs.min.js','renderer/vendor/peerjs.min.js')\"",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win nsis portable --publish never",
    "store": "npm run vendor && electron-builder --win appx --publish never"
  },
  "devDependencies": {
    "d3": "7.9.0",
    "peerjs": "1.5.5",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "lol.fire.team",
    "productName": "FIRE LoL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "coach.js",
      "teamgrab.js",
      "jeux.js",
      "worlds.js",
      "lcu.js",
      "lanes.json",
      "splash.json",
      "voicelines.json",
      "patchnotes.json",
      "emojis.json",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/fire.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FIRE LoL",
      "installerIcon": "assets/fire.ico",
      "uninstallerIcon": "assets/fire.ico",
      "artifactName": "FIRE-LoL-Setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "FIRE-LoL-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Toka120",
        "repo": "fire-team-lol",
        "releaseType": "release"
      }
    ],
    "appx": {
      "applicationId": "FIRELoL",
      "displayName": "FIRE LoL",
      "identityName": "Toks42o.FIRELoL",
      "publisher": "CN=B8EFAA3A-8B5A-4888-81D9-772E2A6DFB2C",
      "publisherDisplayName": "Toks42o",
      "languages": [
        "fr-FR"
      ],
      "backgroundColor": "#0f0d0c",
      "showNameOnTiles": true,
      "artifactName": "FIRE-LoL-Store.appx",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
