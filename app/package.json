{
  "name": "fire-lol",
  "productName": "FIRE LoL",
  "version": "1.10.124",
  "description": "FIRE LoL - les stats de l'équipe, à jour depuis dpm.lol",
  "main": "main.js",
  "author": "Toka120",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "vendor": "node vendor.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win nsis portable --publish never",
    "store": "npm run vendor && electron-builder --win appx --publish never"
  },
  "devDependencies": {
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "d3": "7.9.0",
    "electron": "45.3.0",
    "electron-builder": "25.1.8",
    "lucide-static": "1.72.0",
    "mp4-muxer": "5.2.2",
    "peerjs": "1.5.5"
  },
  "build": {
    "appId": "lol.fire.team",
    "productName": "FIRE LoL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "coach.js",
      "teamgrab.js",
      "jeux.js",
      "worlds.js",
      "lcu.js",
      "lolalytics.js",
      "lanes.json",
      "splash.json",
      "voicelines.json",
      "patchnotes.json",
      "emojis.json",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/fire.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FIRE LoL",
      "installerIcon": "assets/fire.ico",
      "uninstallerIcon": "assets/fire.ico",
      "artifactName": "FIRE-LoL-Setup.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "FIRE-LoL-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Toka120",
        "repo": "fire-team-lol",
        "releaseType": "release"
      }
    ],
    "appx": {
      "applicationId": "FIRELoL",
      "displayName": "FIRE LoL",
      "identityName": "Toks42o.FIRELoL",
      "publisher": "CN=B8EFAA3A-8B5A-4888-81D9-772E2A6DFB2C",
      "publisherDisplayName": "Toks42o",
      "languages": [
        "fr-FR"
      ],
      "backgroundColor": "#0f0d0c",
      "showNameOnTiles": true,
      "artifactName": "FIRE-LoL-Store.appx",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "6.3.9"
  }
}
